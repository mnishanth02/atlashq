{
  "name": "@atlashq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "openapi": "pnpm build && node dist/openapi.js --write && biome format --write openapi/openapi.json",
    "openapi:check": "pnpm build && node dist/openapi.js --check"
  },
  "dependencies": {
    "@atlashq/auth": "workspace:*",
    "@atlashq/config": "workspace:*",
    "@atlashq/logger": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.5",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "vitest": "4.1.10"
  }
}

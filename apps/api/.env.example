NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://atlashq:atlashq-local-password@localhost:5432/atlashq
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-characters
AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:4187
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=replace-with-local-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-minio-secret-key
S3_BUCKET=atlashq-local

# Initial-admin provisioning (trusted CLI only: `pnpm --filter @atlashq/api provision:admin`).
# Public email/password sign-up is disabled on the mounted API, so the first
# organization admin must be bootstrapped explicitly. These are consumed only by
# the provisioning CLI/Compose `bootstrap` profile; never commit real credentials.
INITIAL_ADMIN_ORG_NAME=AtlasHQ
INITIAL_ADMIN_NAME=Initial Admin
INITIAL_ADMIN_EMAIL=admin@atlashq.local
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
